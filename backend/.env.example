# Copy this file to backend/.env for local overrides.
# Environment variables always take precedence over these defaults.

# Embeddings and vector store
RAG_INSPECTOR_EMBEDDING_MODEL=BAAI/bge-m3
RAG_INSPECTOR_EMBEDDING_BACKEND=auto
RAG_INSPECTOR_FAKE_EMBEDDING_DIMS=32
RAG_INSPECTOR_QDRANT_URL=http://127.0.0.1:6333
RAG_INSPECTOR_QDRANT_COLLECTION=rag_inspector

# Local Ollama generation
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=600
RAG_LLM_THINKING=0

# RAG generation controls
RAG_MAX_CONTEXT_TOKENS=4000
RAG_DEFAULT_TEMPERATURE=0.2
# Leave empty to use the built-in citation-aware system prompt.
RAG_SYSTEM_PROMPT=

# Evaluation datasets
RAG_INSPECTOR_EVAL_DIR=examples/evaluation
